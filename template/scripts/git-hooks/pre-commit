#!/usr/bin/env bash
# git pre-commit hook：提交前强制跑质量门禁。
# 启用方式：bash scripts/setup.sh（只需一次，等价于 git config core.hooksPath scripts/git-hooks）
#
# 这是"硬约束"：AGENTS.md 里的铁律靠模型自觉，这里靠 git 拒绝。
# 任何 agent（Claude Code / Codex / Cursor）跑 git commit 都会经过这里。
set -euo pipefail

if [ "${SKIP_GATE:-0}" = "1" ]; then
  printf '\033[1;33m[gate] SKIP_GATE=1，门禁已跳过——仅限人类紧急情况，agent 禁止使用。\033[0m\n'
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
exec bash "$ROOT/scripts/gate.sh"
